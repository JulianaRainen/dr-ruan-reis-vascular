Options -MultiViews
RewriteEngine On

# Vinext static export writes internal pages as .html files. Preserve the
# approved clean URLs when the site is served by Apache on Hostinger.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
